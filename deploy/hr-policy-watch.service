[Unit]
Description=HR website weekly source and policy inventory check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hr-policy-watch
Group=hr-policy-watch
StateDirectory=hr-policy-watch
StateDirectoryMode=0700
ExecStart=/bin/bash /opt/hr-policy-watch/run-policy-watch.sh
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hr-policy-watch
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
