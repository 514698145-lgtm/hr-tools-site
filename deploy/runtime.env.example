# Copy to /etc/hr-tools/runtime.env with root ownership and mode 0600.
# Replace with the final public website origin, not the API origin domain.
HR_PUBLIC_ORIGIN=https://www.example.com
# Without HR_ADMIN_PASSWORD, the first run generates a server-local password
# at /var/lib/hr-tools/admin-password.txt. Retrieve privately; never commit it.
